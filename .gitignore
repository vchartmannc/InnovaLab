# ==============================================================================
# Proyecto: BA Protege+
# Descripción: Archivo de configuración global de Git para exclusión de archivos
# ==============================================================================

# Dependencias de Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variables de entorno y secretos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Compilación y builds
dist/
build/
out/
.next/
*.tsbuildinfo

# Logs y diagnósticos
logs/
*.log

# Entornos de desarrollo y editores (VS Code, Android Studio, IntelliJ)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Android & Gradle (para frontend mobile)
.gradle/
frontend/android/.gradle/
frontend/android/app/build/
frontend/android/build/
frontend/android/captures/
frontend/android/.cxx/
*.apk
*.aab
local.properties

# Prisma
backend/prisma/*.db
backend/prisma/*.db-journal

# Documentación interna de trabajo (no enviar a remoto)
docs/